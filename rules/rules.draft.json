    {
      "id": "W001_high_index_low_rx",
      "name": "Не оверселлить 1.74 при слабой коррекции",
      "description": "Штраф/исключение из optimal при |SPH|<2 и index>=1.74 без особых причин (большая оправа и т.п.)",
      "layer": 3,
      "condition": "max_abs_sph < 2.0 AND index >= 1.74",
      "action": "score_penalty_or_exclude_from_optimal",
      "priority": 70,
      "source": "ABDO/education_index_matching + expert_judgment",
      "confidence": "medium",
      "approval_status": "needs_owner_approval",
      "config_threshold": {"sph_abs": 2.0, "index": 1.74},
      "last_reviewed": "2026-07-24"
    },
    {
      "id": "W002_low_index_high_rx",
      "name": "Не рекомендовать толстый базовый индекс при высокой коррекции",
      "description": "Штраф index<=1.50 при |SPH|>=6",
      "layer": 3,
      "condition": "max_abs_sph >= 6 AND index <= 1.50",
      "action": "score_penalty",
      "priority": 75,
      "source": "education_index_matching + expert_judgment",
      "confidence": "medium",
      "approval_status": "needs_owner_approval",
      "config_threshold": {"sph_abs": 6.0, "index": 1.5},
      "last_reviewed": "2026-07-24"
    },
    {
      "id": "W003_photo_car_uv",
      "name": "Обычный фотохром и автомобиль",
      "description": "Предупреждение: лобовое стекло блокирует большую часть УФ; обычный фотохром в авто темнеет слабо. XTRActive-класс — иное поведение (видимый свет), но не обещать полный sun.",
      "layer": 2,
      "condition": "purpose=car OR drives_often AND photochromic interested AND not xtractive_family",
      "action": "warning_client_plain_language",
      "priority": 60,
      "source": "Transitions_XTRActive_docs + optical_practice",
      "confidence": "high",
      "approval_status": "approved_logic_pending_qa",
      "last_reviewed": "2026-07-24"
    },
