      "id": "H001_sph_range",
      "name": "SPH в диапазоне SKU",
      "description": "Исключить SKU, если сфера глаза вне заявленного диапазона прайса",
      "layer": 1,
      "condition": "sku.sphere_min/max known AND eye.sph outside range",
      "action": "hard_reject",
      "priority": 100,
      "source": "price_list_ranges",
      "confidence": "high",
      "approval_status": "approved_logic_pending_qa",
      "last_reviewed": "2026-07-24"
    },
    {
      "id": "H002_cyl_range",
      "name": "CYL в диапазоне SKU",
      "description": "Исключить при известном лимите цилиндра",
      "layer": 1,
      "condition": "sku.cylinder_max known AND abs(cyl) > limit",
      "action": "hard_reject",
      "priority": 95,
      "source": "price_list_ranges",
      "confidence": "high",
      "approval_status": "approved_logic_pending_qa",
      "last_reviewed": "2026-07-24"
